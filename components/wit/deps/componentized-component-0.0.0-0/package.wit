package componentized:component@0.0.0-0;

interface types {
  variant error {
    other(option<string>),
  }

  resource component {
    into-wasm: func() -> list<u8>;
  }
}

interface wasm-loader {
  use types.{component, error};

  load: async func(wasm: stream<u8>) -> result<component, error>;
}

interface wat-loader {
  use types.{component, error};

  load: async func(wat: stream<u8>) -> result<component, error>;
}

interface filesystem-loader {
  use types.{component, error};

  load: async func(path: string) -> result<component, error>;
}

interface oci-loader {
  use types.{component, error};

  load: async func(image: string) -> result<component, error>;
}

interface wasm-directory-loader {
  use types.{component, error};

  load: async func(manifest-key: string) -> result<component, error>;
}

interface wac-loader {
  use types.{component, error};

  plug: async func(socket: borrow<component>, plugs: list<borrow<component>>) -> result<component, error>;
}

interface wit {
  use types.{component, error};

  record world-id {
    world-id: u32,
  }

  record interface-id {
    interface-id: u32,
  }

  record type-id {
    type-id: u32,
  }

  record package-id {
    package-id: u32,
  }

  variant %type {
    %bool,
    %s8,
    %s16,
    %s32,
    %s64,
    %u8,
    %u16,
    %u32,
    %u64,
    %f32,
    %f64,
    %char,
    %string,
    %error-context,
    id(type-id),
  }

  variant handle {
    %own(type-id),
    %borrow(type-id),
  }

  variant type-owner {
    %world(world-id),
    %interface(interface-id),
    none,
  }

  record docs {
    contents: option<string>,
  }

  variant version-identifier {
    %string(string),
    numeric(u64),
  }

  record version {
    major: u64,
    minor: u64,
    patch: u64,
    prerelease: option<list<version-identifier>>,
    build-metadata: option<list<version-identifier>>,
  }

  record unstable {
    feature: string,
    deprecated: option<version>,
  }

  record stable {
    since: version,
    deprecated: option<version>,
  }

  variant stability {
    unknown,
    unstable(unstable),
    stable(stable),
  }

  record world-item-interface {
    id: interface-id,
    stability: stability,
    external-id: option<string>,
    docs: docs,
  }

  record world-item-type {
    id: type-id,
  }

  record include-name {
    name: string,
    %as: string,
  }

  record world-include {
    stability: stability,
    id: world-id,
    names: list<include-name>,
  }

  variant world-key {
    name(string),
    %interface(interface-id),
  }

  record package-name {
    namespace: string,
    name: string,
    version: option<version>,
  }

  record %package {
    name: package-name,
    docs: docs,
    interfaces: list<tuple<string, interface-id>>,
    worlds: list<tuple<string, world-id>>,
  }

  record field {
    name: string,
    %type: %type,
    docs: docs,
  }

  record %record {
    fields: list<field>,
  }

  record flag {
    name: string,
    docs: docs,
  }

  record %flags {
    %flags: list<flag>,
  }

  record %tuple {
    types: list<%type>,
  }

  record case {
    name: string,
    %type: option<%type>,
    docs: docs,
  }

  record %variant {
    cases: list<case>,
  }

  record enum-case {
    name: string,
    docs: docs,
  }

  record %enum {
    cases: list<enum-case>,
  }

  record %result {
    ok: option<%type>,
    err: option<%type>,
  }

  variant type-def-kind {
    %record(%record),
    %resource,
    handle(handle),
    %flags(%flags),
    %tuple(%tuple),
    %variant(%variant),
    %enum(%enum),
    %option(%type),
    %result(%result),
    %list(tuple<%type, option<u32>>),
    %map(tuple<%type, %type>),
    %future(option<%type>),
    %stream(option<%type>),
    %type(%type),
    unknown,
  }

  record type-def {
    name: option<string>,
    kind: type-def-kind,
    owner: type-owner,
    docs: docs,
    stability: stability,
    external-id: option<string>,
  }

  variant function-kind {
    freestanding,
    async-freestanding,
    method(type-id),
    async-method(type-id),
    %static(type-id),
    async-static(type-id),
    %constructor(type-id),
  }

  record param {
    name: string,
    %type: %type,
  }

  record function {
    name: string,
    kind: function-kind,
    params: list<param>,
    %result: option<%type>,
    docs: docs,
    stability: stability,
    external-id: option<string>,
  }

  record %interface {
    name: option<string>,
    types: list<tuple<string, type-id>>,
    functions: list<tuple<string, function>>,
    docs: docs,
    stability: stability,
    %package: option<package-id>,
  }

  variant world-item {
    %interface(world-item-interface),
    function(function),
    %type(world-item-type),
  }

  record %world {
    name: string,
    imports: list<tuple<world-key, world-item>>,
    exports: list<tuple<world-key, world-item>>,
    %package: option<package-id>,
    docs: docs,
    stability: stability,
    includes: list<world-include>,
  }

  resource wit {
    %world: func(id: world-id) -> option<%world>;
    %interface: func(id: interface-id) -> option<%interface>;
    %type: func(id: type-id) -> option<type-def>;
    %package: func(id: package-id) -> option<%package>;
  }

  extract: async func(component: borrow<component>) -> result<tuple<wit, %package>, error>;
}

world imports {
  import types;
  import wasm-loader;
  import wat-loader;
  import filesystem-loader;
  import oci-loader;
  import wasm-directory-loader;
  import wac-loader;
  import wit;
}
